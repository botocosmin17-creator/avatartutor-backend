<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AvatarTutor - AI-Powered Exam Prep</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6366f1;
            --secondary: #ec4899;
            --accent: #14b8a6;
            --dark: #1f2937;
            --light: #f3f4f6;
            --border: #e5e7eb;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: var(--dark);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        header {
            background: white;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 30px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            color: var(--primary);
            font-size: 28px;
        }

        .auth-buttons {
            display: flex;
            gap: 10px;
        }

        button {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background: #4f46e5;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
        }

        .btn-secondary {
            background: var(--light);
            color: var(--dark);
            border: 2px solid var(--border);
        }

        .btn-secondary:hover {
            background: white;
            border-color: var(--primary);
        }

        .main-content {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        .avatar-card {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: fit-content;
        }

        .avatar-canvas {
            width: 250px;
            height: 250px;
            background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
            border-radius: 50%;
            margin-bottom: 20px;
            border: 3px solid var(--primary);
        }

        .avatar-controls {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .avatar-controls button {
            width: 100%;
        }

        .dashboard {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .dashboard h2 {
            color: var(--primary);
            margin-bottom: 20px;
            font-size: 20px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: var(--light);
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            border-left: 4px solid var(--primary);
        }

        .stat-card h3 {
            font-size: 12px;
            color: #6b7280;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .stat-card .value {
            font-size: 24px;
            font-weight: bold;
            color: var(--primary);
        }

        .section {
            margin-bottom: 30px;
        }

        .section h3 {
            color: var(--dark);
            margin-bottom: 15px;
            font-size: 16px;
        }

        .input-group {
            display: flex;
            gap: 10px;
        }

        input[type="text"],
        textarea {
            flex: 1;
            padding: 12px;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-family: inherit;
            font-size: 14px;
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        input[type="text"]:focus,
        textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

        .questions-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .question-card {
            background: var(--light);
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid var(--accent);
        }

        .question-card h4 {
            color: var(--dark);
            margin-bottom: 12px;
        }

        .options {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .option {
            padding: 10px;
            background: white;
            border: 2px solid var(--border);
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .option:hover {
            border-color: var(--primary);
            background: rgba(99, 102, 241, 0.05);
        }

        .option.selected {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .option.correct {
            background: #10b981;
            color: white;
            border-color: #10b981;
        }

        .option.incorrect {
            background: #ef4444;
            color: white;
            border-color: #ef4444;
        }

        .option.show-correct {
            background: #dbeafe;
            border-color: #3b82f6;
            color: #1e40af;
            font-weight: 600;
        }

        .explanation {
            margin-top: 12px;
            padding: 12px;
            background: white;
            border-radius: 6px;
            border-left: 3px solid var(--accent);
            font-size: 13px;
            color: #4b5563;
        }

        .loading {
            text-align: center;
            padding: 20px;
            color: var(--primary);
        }

        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(99, 102, 241, 0.2);
            border-radius: 50%;
            border-top-color: var(--primary);
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .success {
            background: #d1fae5;
            color: #059669;
            padding: 12px;
            border-radius: 6px;
            margin-top: 10px;
        }

        .error {
            background: #fee2e2;
            color: #dc2626;
            padding: 12px;
            border-radius: 6px;
            margin-top: 10px;
        }

        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
        }

        .modal.active {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: white;
            padding: 30px;
            border-radius: 12px;
            width: 90%;
            max-width: 400px;
            position: relative;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        }

        .close-modal {
            position: absolute;
            right: 20px;
            top: 20px;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            color: #6b7280;
        }

        .close-modal:hover {
            color: var(--dark);
        }

        .modal-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 20px;
        }

        .modal-form input {
            padding: 12px;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 14px;
        }

        .modal-form button {
            padding: 12px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .modal-form button:hover {
            background: #4f46e5;
        }

        .study-groups {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .group-item {
            background: var(--light);
            padding: 15px;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 4px solid var(--accent);
        }

        .group-info h4 {
            color: var(--dark);
            margin-bottom: 5px;
        }

        .group-info p {
            font-size: 12px;
            color: #6b7280;
        }

        .badge {
            background: var(--accent);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }

        @media (max-width: 768px) {
            .main-content {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            header {
                flex-direction: column;
                gap: 15px;
            }
        }
    </style>
</head>
<body>
    <!-- Backend URL Configuration - CHANGE THIS TO YOUR RAILWAY URL -->
    <script>
        // Set your Railway backend URL here
        window.BACKEND_URL = 'https://avatartutor-backend-production.up.railway.app'; // Your Railway backend
        // For local testing: 'http://localhost:8000'
    </script>

    <div class="container">
        <header>
            <div>
                <h1>🧠 AvatarTutor</h1>
                <p style="color: #6b7280; margin-top: 5px;">AI-Powered Exam Prep Platform</p>
            </div>
            <div class="auth-buttons">
                <button class="btn-secondary" onclick="showLogin()">Sign In</button>
                <button class="btn-primary" onclick="showSignup()">Sign Up</button>
            </div>
        </header>

        <div class="main-content">
            <!-- Avatar Section -->
            <div class="avatar-card">
                <canvas id="avatarCanvas" class="avatar-canvas"></canvas>
                <div class="avatar-controls">
                    <button class="btn-primary" onclick="playAvatarAnimation('happy')">😊 Happy</button>
                    <button class="btn-primary" onclick="playAvatarAnimation('thinking')">🤔 Thinking</button>
                    <button class="btn-primary" onclick="speakMessage()">🔊 Speak</button>
                </div>
            </div>

            <!-- Dashboard Section -->
            <div class="dashboard">
                <h2>📊 Your Progress</h2>
                
                <div class="stats-grid">
                    <div class="stat-card">
                        <h3>Score</h3>
                        <div class="value" id="score">0</div>
                    </div>
                    <div class="stat-card">
                        <h3>Streak</h3>
                        <div class="value" id="streak">0</div>
                    </div>
                    <div class="stat-card">
                        <h3>Level</h3>
                        <div class="value" id="level">1</div>
                    </div>
                    <div class="stat-card">
                        <h3>Accuracy</h3>
                        <div class="value" id="accuracy">0%</div>
                    </div>
                </div>

                <!-- Generate Questions Section -->
                <div class="section">
                    <h3>📝 Generate Practice Questions</h3>
                    <div class="input-group">
                        <textarea id="contentInput" placeholder="Paste study material, PDF text, or topic to generate questions..." style="flex: 1;"></textarea>
                    </div>
                    <button class="btn-primary" onclick="generateQuestions()" style="margin-top: 10px; width: 100%;">Generate Questions</button>
                    <div id="generateStatus"></div>
                </div>

                <!-- Questions Display -->
                <div class="section">
                    <h3>❓ Practice Questions</h3>
                    <div id="questionsList" class="questions-list"></div>
                </div>

                <!-- Study Groups Section -->
                <div class="section">
                    <h3>👥 Study Groups</h3>
                    <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                        <button class="btn-secondary" onclick="showCreateGroup()">Create Group</button>
                        <button class="btn-secondary" onclick="showJoinGroup()">Join Group</button>
                    </div>
                    <div id="groupsList" class="study-groups"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <div id="loginModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('loginModal')">&times;</span>
            <h2>Sign In</h2>
            <div class="modal-form">
                <input type="text" placeholder="Email">
                <input type="text" placeholder="Password">
                <button class="btn-primary">Sign In</button>
            </div>
        </div>
    </div>

    <div id="signupModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('signupModal')">&times;</span>
            <h2>Create Account</h2>
            <div class="modal-form">
                <input type="text" placeholder="Full Name">
                <input type="text" placeholder="Email">
                <input type="text" placeholder="Password">
                <button class="btn-primary">Sign Up</button>
            </div>
        </div>
    </div>

    <div id="createGroupModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('createGroupModal')">&times;</span>
            <h2>Create Study Group</h2>
            <div class="modal-form">
                <input type="text" placeholder="Group Name">
                <input type="text" placeholder="Group Description">
                <button class="btn-primary">Create Group</button>
            </div>
        </div>
    </div>

    <div id="joinGroupModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('joinGroupModal')">&times;</span>
            <h2>Join Study Group</h2>
            <div class="modal-form">
                <input type="text" placeholder="Enter invite code">
                <button class="btn-primary">Join Group</button>
            </div>
        </div>
    </div>

    <script>
        // Global state
        let currentQuestions = [];
        let answeredQuestions = {}; // Track answered questions: { questionIdx: { selected, isCorrect } }
        let userStats = {
            score: 0,
            streak: 0,
            level: 1,
            totalAnswered: 0,
            correctAnswers: 0
        };

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            drawAvatar();
            renderGroups();
            updateStats();
        });

        // Modal functions
        function showModal(id) {
            document.getElementById(id).classList.add('active');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        function showLogin() { showModal('loginModal'); }
        function showSignup() { showModal('signupModal'); }
        function showCreateGroup() { showModal('createGroupModal'); }
        function showJoinGroup() { showModal('joinGroupModal'); }

        // Avatar drawing
        function drawAvatar(emotion = 'neutral') {
            const canvas = document.getElementById('avatarCanvas');
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            canvas.width = 250;
            canvas.height = 250;

            // Clear canvas
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Head
            ctx.fillStyle = '#FDB4B4';
            ctx.beginPath();
            ctx.arc(125, 100, 60, 0, Math.PI * 2);
            ctx.fill();

            // Eyes
            ctx.fillStyle = '#333';
            ctx.beginPath();
            ctx.arc(105, 85, 8, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(145, 85, 8, 0, Math.PI * 2);
            ctx.fill();

            // Mouth
            ctx.strokeStyle = '#333';
            ctx.lineWidth = 3;
            ctx.beginPath();
            if (emotion === 'happy') {
                ctx.arc(125, 110, 15, 0, Math.PI);
            } else if (emotion === 'thinking') {
                ctx.arc(125, 115, 10, Math.PI, 0, true);
            } else {
                ctx.moveTo(110, 110);
                ctx.lineTo(140, 110);
            }
            ctx.stroke();

            // Eyes shine
            ctx.fillStyle = 'white';
            ctx.beginPath();
            ctx.arc(107, 83, 3, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(147, 83, 3, 0, Math.PI * 2);
            ctx.fill();
        }

        function playAvatarAnimation(emotion) {
            drawAvatar(emotion);
            setTimeout(() => drawAvatar(), 2000);
        }

        // API calls to backend
        async function generateQuestions() {
            const content = document.getElementById('contentInput').value;
            
            if (!content.trim()) {
                showMessage('generateStatus', 'Please enter content', 'error');
                return;
            }

            const status = document.getElementById('generateStatus');
            status.innerHTML = '<div class="loading"><div class="spinner"></div> Generating questions...</div>';

            try {
                const response = await fetch(`${window.BACKEND_URL}/api/generatequestions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ content })
                });

                if (!response.ok) {
                    throw new Error(`API error: ${response.status}`);
                }

                const data = await response.json();
                currentQuestions = data.questions;
                answeredQuestions = {}; // Reset answered questions
                renderQuestions();
                status.innerHTML = '<div class="success">✓ Questions generated successfully!</div>';
                document.getElementById('contentInput').value = '';
            } catch (error) {
                console.error('Error:', error);
                status.innerHTML = `<div class="error">❌ Error: ${error.message}. Make sure your backend is running at: ${window.BACKEND_URL}</div>`;
            }
        }

        async function speakMessage() {
            const text = "I'm your AI tutor. Let's practice together!";

            try {
                const response = await fetch(`${window.BACKEND_URL}/api/speak`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ text })
                });

                if (!response.ok) {
                    throw new Error(`API error: ${response.status}`);
                }

                const data = await response.json();
                const audio = new Audio(data.audio);
                audio.play();
                playAvatarAnimation('happy');
            } catch (error) {
                console.error('Speech error:', error);
                alert('Speech synthesis unavailable. Check backend is running.');
            }
        }

        // Render functions
        function renderQuestions() {
            const container = document.getElementById('questionsList');
            
            if (!currentQuestions || currentQuestions.length === 0) {
                container.innerHTML = '<p style="color: #6b7280;">No questions yet. Generate some to get started!</p>';
                return;
            }

            container.innerHTML = currentQuestions.map((q, idx) => {
                const answered = answeredQuestions[idx];
                const isAnswered = answered !== undefined;
                
                return `
                    <div class="question-card">
                        <h4>Question ${idx + 1}: ${q.question}</h4>
                        <div class="options">
                            ${q.options.map((opt, optIdx) => {
                                let optionClass = 'option';
                                if (isAnswered) {
                                    if (optIdx === answered.selected) {
                                        optionClass += answered.isCorrect ? ' correct' : ' incorrect';
                                    } else if (optIdx === q.correct && answered.selected !== q.correct) {
                                        optionClass += ' show-correct';
                                    }
                                }
                                return `
                                    <div class="${optionClass}" onclick="selectAnswer(${idx}, ${optIdx})" ${isAnswered ? 'style="pointer-events: none;"' : ''}>
                                        ${String.fromCharCode(65 + optIdx)}. ${opt}
                                    </div>
                                `;
                            }).join('')}
                        </div>
                        ${isAnswered ? `
                            <div style="margin-top: 15px; padding: 12px; border-radius: 8px; ${answered.isCorrect ? 'background: #d1fae5; border: 2px solid #10b981;' : 'background: #fee2e2; border: 2px solid #ef4444;'}">
                                <strong style="color: ${answered.isCorrect ? '#059669' : '#dc2626'}">
                                    ${answered.isCorrect ? '✓ Correct!' : '✗ Incorrect'}
                                </strong>
                                ${q.explanation ? `
                                    <div style="margin-top: 10px; color: #374151;">
                                        <strong>Explanation:</strong> ${q.explanation}
                                    </div>
                                ` : ''}
                            </div>
                        ` : ''}
                    </div>
                `;
            }).join('');
        }

        function selectAnswer(questionIdx, optionIdx) {
            // Don't allow re-answering
            if (answeredQuestions[questionIdx] !== undefined) {
                return;
            }
            
            const question = currentQuestions[questionIdx];
            const isCorrect = optionIdx === question.correct;
            
            // Record answer
            answeredQuestions[questionIdx] = {
                selected: optionIdx,
                isCorrect: isCorrect
            };
            
            // Update stats
            if (isCorrect) {
                userStats.correctAnswers++;
                userStats.streak++;
                userStats.score += 10;
            } else {
                userStats.streak = 0;
                userStats.score = Math.max(0, userStats.score - 5);
            }
            
            userStats.totalAnswered++;
            updateStats();
            
            // Show avatar reaction
            playAvatarAnimation(isCorrect ? 'happy' : 'thinking');
            
            // Re-render to show feedback
            renderQuestions();
        }

        function renderGroups() {
            const container = document.getElementById('groupsList');
            const groups = [
                { name: 'GMAT Prep 2024', members: 42, code: 'GMAT123' },
                { name: 'IELTS Study Squad', members: 28, code: 'IELTS456' }
            ];

            container.innerHTML = groups.map(g => `
                <div class="group-item">
                    <div class="group-info">
                        <h4>${g.name}</h4>
                        <p>${g.members} members • Code: ${g.code}</p>
                    </div>
                    <span class="badge">Active</span>
                </div>
            `).join('');
        }

        function updateStats() {
            document.getElementById('score').textContent = userStats.score;
            document.getElementById('streak').textContent = userStats.streak;
            document.getElementById('level').textContent = Math.floor(userStats.score / 100) + 1;
            const accuracy = userStats.totalAnswered > 0 
                ? Math.round((userStats.correctAnswers / userStats.totalAnswered) * 100)
                : 0;
            document.getElementById('accuracy').textContent = accuracy + '%';
        }

        function showMessage(elementId, message, type) {
            document.getElementById(elementId).innerHTML = `<div class="${type}">${message}</div>`;
        }

        // Close modals on outside click
        window.onclick = function(event) {
            ['loginModal', 'signupModal', 'createGroupModal', 'joinGroupModal'].forEach(id => {
                const modal = document.getElementById(id);
                if (event.target === modal) {
                    modal.classList.remove('active');
                }
            });
        }
    </script>
</body>
</html>
